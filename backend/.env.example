# --- Core -------------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Must be "false" in production. Enables HTTPS redirects, secure cookies and HSTS.
DJANGO_DEBUG=true
# Comma-separated. Production: your backend hostname, e.g. bogdannica-api.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme. Production: https://<your-app>.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---------------------------------------------------------------
# Leave empty to use local SQLite (backend/db.sqlite3).
# Production: the managed Postgres connection string, e.g.
# postgres://user:password@host:5432/dbname
DATABASE_URL=
# Set to true if your provider requires SSL and the URL lacks ?sslmode=require
DATABASE_SSL_REQUIRE=false

# --- Media uploads (django-storages, S3-compatible) -------------------------
# Leave AWS_STORAGE_BUCKET_NAME empty to store uploads under backend/media/ (dev only).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS: the bucket region, e.g. eu-central-1. Cloudflare R2: auto
AWS_S3_REGION_NAME=auto
# Non-AWS providers only. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# Public hostname files are served from, without scheme.
# AWS: <bucket>.s3.<region>.amazonaws.com   R2: pub-xxxx.r2.dev or your custom domain
AWS_S3_CUSTOM_DOMAIN=
# Folder prefix inside the bucket.
AWS_LOCATION=media
# false => plain public URLs (bucket must allow public reads).
# true  => signed, expiring URLs (bucket can stay private).
AWS_QUERYSTRING_AUTH=false

# --- Site URLs (used in e-mails) --------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- E-mail -----------------------------------------------------------------
ADMIN_EMAIL=
DEFAULT_FROM_EMAIL=Bogdannica <noreply@example.com>
# Leave EMAIL_HOST empty to print e-mails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# --- Optional ---------------------------------------------------------------
# Gunicorn worker count (Procfile). 2 is right for a small instance.
WEB_CONCURRENCY=2
DJANGO_LOG_LEVEL=INFO
# Set to false only if the platform already forces HTTPS and redirects loop.
DJANGO_SECURE_SSL_REDIRECT=true
